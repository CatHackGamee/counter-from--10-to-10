<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Счетчик</title>
    <style>
        body {
            background: linear-gradient(#4a00e0, #8e2de2);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial;
        }

        #num {
            font-size: 80px;
            font-weight: bold;
            color: #fff;
            width: 150px;
            height: 150px;
            line-height: 150px;
            border-radius: 20px;
            margin: 0 auto 30px;
	    text-align: center;
        }

        .btns {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-bottom: 25px;
        }

        button {
            font-size: 40px;
            width: 70px;
            height: 70px;
            border: none;
            border-radius: 5px;
            background: #ddd;
            cursor: pointer;
        }

        button:disabled {
            opacity: 0.4;
        }

        #msg {
            color: #fff;
            font-size: 18px;
            min-height: 25px;
        }
    </style>
</head>
<body>

<div>
    <div id="num">0</div>
    <div class="btns">
        <button id="minus">-</button>
        <button id="plus">+</button>
    </div>
    <div id="msg"></div>
</div>

<script>
    let x = 0
    const num = document.getElementById('num')
    const plus = document.getElementById('plus')
    const minus = document.getElementById('minus')
    const msg = document.getElementById('msg')
    
    function upd() {
        num.textContent = x
        num.style.background = x > 0 ? '#ffd700' : x < 0 ? '#4caf50' : '#f44336'
        plus.disabled = x === 10
        minus.disabled = x === -10
        msg.textContent = (x === 10 || x === -10) ? 'вы достигли экстремального значения' : ''
    }
    
    plus.onclick = () => { if (x < 10) { x++; upd() } }
    minus.onclick = () => { if (x > -10) { x--; upd() } }
    
    upd()
</script>

</body>
</html>
